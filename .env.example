# Dashboard app URL the landing CTAs link to.
NEXT_PUBLIC_DASHBOARD_URL=https://app.wire.mn

# Sentry (optional — empty disables; build-time, inlined into the client bundle)
NEXT_PUBLIC_SENTRY_DSN=        # wire-frontend project DSN
NEXT_PUBLIC_SENTRY_ENV=production
NEXT_PUBLIC_GIT_SHA=           # release tag (= GIT_SHA)
SENTRY_AUTH_TOKEN=            # source-map upload only; never commit
SENTRY_ORG=
SENTRY_PROJECT=
